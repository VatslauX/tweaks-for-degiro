{
  "manifest_version": 3,
  "name": "Tweaks for DEGIRO (unofficial)",
  "version": "1.19.1",
  "minimum_chrome_version": "111",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/VatslauX/tweaks-for-degiro",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Tweaks for DEGIRO (unofficial)",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://trader.degiro.nl/trader/*"
      ],
      "js": [
        "common-isolated.js",
        "flags.js",
        "content.js",
        "exdiv.js",
        "compact.js",
        "hide.js",
        "adjust-close.js",
        "orders-table.js",
        "status.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://trader.degiro.nl/trader/*"
      ],
      "js": [
        "common.js",
        "chart-select.js",
        "orders.js",
        "period.js",
        "portfolio.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}