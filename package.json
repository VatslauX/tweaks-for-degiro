{
  "name": "tweaks-for-degiro",
  "description": "Unofficial Chrome extension that adds quality-of-life features to the DEGIRO web trader.",
  "scripts": {
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.isolated.json && tsc -p tsconfig.page.json && tsc -p tsconfig.options.json",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"extension/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 tests/unit/*.test.js tests/integration/*.test.js",
    "badge:coverage": "node scripts/coverage-badge.js",
    "badge:malware": "node scripts/malware-badge.js",
    "test:e2e": "playwright test",
    "test:report": "node scripts/test-report.js",
    "build": "node scripts/build.js",
    "store-images": "playwright test --config scripts/store-images.config.js",
    "sync-common": "node -e \"require('fs').copyFileSync('extension/common.js','extension/common-isolated.js')\"",
    "lint": "eslint ."
  },
  "author": "VatslauX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VatslauX/tweaks-for-degiro.git"
  },
  "homepage": "https://github.com/VatslauX/tweaks-for-degiro",
  "bugs": {
    "url": "https://github.com/VatslauX/tweaks-for-degiro/issues"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "badgen": "^3.3.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "highcharts": "4.2.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  },
  "private": true
}
